DATABASE_URL="postgresql://agentgate:agentgate@localhost:5433/agentgate"
GATEWAY_PORT=4000
# --- Day 2+ settings ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest
GATEWAY_URL=http://localhost:4000
# Leave empty locally. Set a long random value when deploying publicly.
ADMIN_TOKEN=
# New tools are approved automatically on first sight (demo convenience)
AUTO_APPROVE_NEW_TOOLS=true
# Estimated cost of tokens that tool results add to an agent's context
TOOL_COST_AUD_PER_1K_TOKENS=0.0045
